    "organization": "CORE AITU",
    "sourceSvg": "logo/logo_inkscape.svg",
    "gridStepMm": 3.52778,
    "unitScale": 10.0,
    "baseLetterSize": {
      "width": 50,
      "height": 50
    },
    "letterGap": 10
  },
  "geometry": {
    "letters": {
      "C": {
        "description": "Modular block letter C with open right aperture",
        "boxes": [
          { "x": 0, "y": 10, "w": 10, "h": 30, "type": "stem" },
          { "x": 10, "y": 40, "w": 40, "h": 10, "type": "top-bar" },
          { "x": 10, "y": 0, "w": 40, "h": 10, "type": "bottom-bar" }
        ],
        "outerContour": [
          [0, 0], [0, 50], [50, 50], [50, 40], [10, 40], [10, 10], [50, 10], [50, 0]
        ]
      },
      "O": {
        "description": "Modular block letter O with central square aperture and centered 1.4x core dot",
        "boxes": [
          { "x": 0, "y": 10, "w": 10, "h": 30, "type": "left-bar" },
          { "x": 40, "y": 10, "w": 10, "h": 30, "type": "right-bar" },
          { "x": 10, "y": 40, "w": 30, "h": 10, "type": "top-bar" },
          { "x": 10, "y": 0, "w": 30, "h": 10, "type": "bottom-bar" }
        ],
        "coreDot": {
          "x": 18,
          "y": 18,
          "w": 14,
          "h": 14,
          "center": [25, 25],
          "description": "Authentic Inkscape 4.94mm (1.4x grid step) center core square"
        },
        "outerContour": [
          [0, 10], [0, 40], [10, 50], [40, 50], [50, 40], [50, 10], [40, 0], [10, 0]
        ],
        "holeContour": [
          [10, 10], [10, 40], [40, 40], [40, 10]
        ]
      },
      "R": {
        "description": "Modular letter R with upper closed loop and precise Inkscape diagonal leg",
        "boxes": [
          { "x": 0, "y": 0, "w": 10, "h": 50, "type": "stem" },
          { "x": 10, "y": 40, "w": 40, "h": 10, "type": "top-bar" },
          { "x": 40, "y": 20, "w": 10, "h": 20, "type": "right-loop" },
          { "x": 10, "y": 20, "w": 30, "h": 10, "type": "mid-bar" }
        ],
        "diagonalLeg": {
          "polygon": [
            [25, 20],
            [35, 20],
            [50, 0],
            [40, 0]
          ],
          "description": "Slanted support leg with exact dx=15, dy=20 slope connecting mid-bar to baseline"
        },
        "outerContour": [
          [0, 0], [0, 50], [50, 50], [50, 20], [35, 20], [50, 0], [40, 0], [25, 20], [10, 20], [10, 0]
        ],
        "holeContour": [
          [10, 30], [40, 30], [40, 40], [10, 40]
        ]
      },
      "E": {
        "description": "Modular letter E with three identical horizontal bars and notched spine",
        "boxes": [
          { "x": 0, "y": 0, "w": 10, "h": 50, "type": "stem" },
          { "x": 10, "y": 40, "w": 40, "h": 10, "type": "top-bar" },
          { "x": 10, "y": 20, "w": 40, "h": 10, "type": "mid-bar" },
          { "x": 10, "y": 0, "w": 40, "h": 10, "type": "bottom-bar" }
        ],
        "outerContour": [
          [0, 0], [0, 50], [50, 50], [50, 40], [10, 40], [10, 30], [50, 30], [50, 20], [10, 20], [10, 10], [50, 10], [50, 0]
        ]
      }
    }
  },
