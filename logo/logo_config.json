{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "core-aitu-logo-config",
  "version": "2.0.0",
  "description": "Canonical configuration, metadata, theme presets, and SVG-derived geometry for CORE AITU 3D Logo Exporter and downstream applications.",
